<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>EnableUnreleasedForms</AssemblyName>
    <Product>EnableUnreleasedForms</Product>
    <Version>1.0.0</Version>
    <Description>Enables selecting any of the 7 unreleased character forms during new character creation.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>EnableUnreleasedForms</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <BookOfTravelsDirectory>D:\data_windows\SteamLibrary\steamapps\common\Book of Travels\</BookOfTravelsDirectory>
    <BookOfTravelsLibraryDirectory>$(BookOfTravelsDirectory)BookOfTravels_Data\Managed\</BookOfTravelsLibraryDirectory>
    <BepInExDirectory>$(BookOfTravelsDirectory)BepInEx\</BepInExDirectory>
    <BepInExCoreDirectory>$(BepInExDirectory)core\</BepInExCoreDirectory>
    <BepInExPluginsDirectory>$(BepInExDirectory)plugins\</BepInExPluginsDirectory>
  </PropertyGroup>

  <PropertyGroup>
    <OutputPath>bin\$(AssemblyName)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDirectory)BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDirectory)0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine">
      <HintPath>$(BookOfTravelsLibraryDirectory)UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(BookOfTravelsLibraryDirectory)UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Years.General.General.Assembly">
      <HintPath>$(BookOfTravelsLibraryDirectory)Years.General.General.Assembly.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Years.General.Base.Assembly">
      <HintPath>$(BookOfTravelsLibraryDirectory)Years.General.Base.Assembly.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror">
      <HintPath>$(BookOfTravelsLibraryDirectory)Mirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>

  <!-- BEGIN: Copy build to plugins Directory -->
  <ItemGroup>
    <CompiledFiles Include="bin\**/*.*"/>
  </ItemGroup>

  <Target Name="CopyCustomContent" AfterTargets="AfterBuild">
    <Copy
    SourceFiles="@(CompiledFiles)"
    DestinationFolder="$(BepInExPluginsDirectory)%(RecursiveDirectory)"
    />
  </Target>
  <!-- END: Copy build to plugins Directory -->

</Project>
